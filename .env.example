# Google Analytics 4 measurement ID (Admin → Data streams → your web stream). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Optional proxy for yt-dlp, e.g. http://user:pass@host:port. Use it if YouTube answers your
# server with "Sign in to confirm you're not a bot" (common on cloud/datacenter IPs).
YTDLP_PROXY=
